# Supabase (required): Project settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Drive cloud backup (optional): Google Cloud Console → OAuth client ID
# (Web application, Authorized JavaScript origins: http://localhost:7000 + your
# production origin). Without it the "Cloud backup" block stays hidden.
VITE_GOOGLE_CLIENT_ID=
